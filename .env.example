# ─── Lark / 飞书 Open Platform ───────────────────────────────────────────────
# Create an app at https://open.feishu.cn/app (or https://open.larksuite.com for
# the international edition) and copy its credentials here.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Domain: "feishu" (China) or "lark" (international). Defaults to feishu.
LARK_DOMAIN=feishu

# A user access token is required for APIs that act on behalf of a user, such as
# reading Minutes (妙记) or creating docs in a user's space. Optional for
# tenant-level calls.
LARK_USER_ACCESS_TOKEN=

# ─── LLM provider ────────────────────────────────────────────────────────────
# Which provider the assistant uses for drafting/analysis: "anthropic" (default).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Context system ──────────────────────────────────────────────────────────
# Where the local context store lives. Defaults to ./.opc
OPC_CONTEXT_DIR=.opc
